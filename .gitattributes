# Shell scripts must stay LF or bash fails on them.
*.sh text eol=lf

# A's generated replay files (Stage 3): byte-identical on every OS, so rebuilds never show as changed.
*.mp3 binary
web/public/replay/**/cues.*.jsonl text eol=lf
web/public/replay/**/*.vtt text eol=lf
web/public/replay/**/audio/**/index.json text eol=lf
web/public/replay/**/answers/*.json text eol=lf
web/public/replay/**/manifest.json text eol=lf
