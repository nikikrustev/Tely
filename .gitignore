# Secrets: never commit. Only .env.example (no values) is tracked.
.env
.env.*
!.env.example

# Build and run output
out/
dist/
node_modules/
.azure/
playwright-report/
test-results/
blob-report/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Raw CC0 downloads (licences tracked in assets/licences.json instead)
assets/raw/

# Local listening tests with real club and player names (D21): never committed, never deployed.
# The name maps and the bundles rendered from them stay on the machine that made them.
*.local.json
web/.local/
