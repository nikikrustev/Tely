{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    { "route": "/replay/v1/judge/audio/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/crowd/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/replay/*", "headers": { "Cache-Control": "public, max-age=300, must-revalidate" } },
    { "route": "/live.json", "headers": { "Cache-Control": "no-cache" } }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/replay/*", "/assets/*", "/crowd/*"]
  },
  "mimeTypes": {
    ".jsonl": "application/x-ndjson",
    ".gz": "application/gzip",
    ".vtt": "text/vtt",
    ".mp3": "audio/mpeg",
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
