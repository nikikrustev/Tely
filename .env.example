# Copy to .env (git-ignored) and fill in. Only Person A (potencialbg) holds a .env with values.
# Auth is keyless first: run `az login`, and DefaultAzureCredential picks it up.

# Foundry resource name (the custom domain), e.g. as-foundry-dev
FOUNDRY_RESOURCE=
# Foundry project endpoint from the portal (Stage 5 agents)
FOUNDRY_PROJECT_ENDPOINT=
# Deployment name for the Director/Explain model
FOUNDRY_MODEL=gpt-5.4-mini

SPEECH_REGION=swedencentral
# Custom-domain endpoint, e.g. https://as-foundry-dev.cognitiveservices.azure.com/
SPEECH_ENDPOINT=
# Optional. Only if keyless auth fails. Never commit or paste it anywhere.
SPEECH_KEY=
# HD voices: en-US DragonHD only, real-time only (file 43 §7)
TTS_VOICE=en-US-Andrew:DragonHDLatestNeural
